# Необязательно: без ключа сервис возвращает сравнительные шаблоны.
# Скопируйте в .env и запускайте uvicorn с --env-file .env,
# либо задайте переменные в окружении shell перед запуском.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
# Для NVIDIA: смените LLM_PROVIDER=nvidia, задайте NVIDIA_API_KEY и NVIDIA_MODEL.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
EXPLANATIONS_LLM_ENABLED=true
